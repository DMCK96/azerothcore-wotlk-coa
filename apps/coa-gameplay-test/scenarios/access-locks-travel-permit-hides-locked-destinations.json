{
  "schema": 1,
  "name": "Area access: the Travel Permit hides Ammen Vale and Sunstrider Isle while they are locked",
  "contract": "The Travel Permit (item 977028, spell 1001088, level 8 or lower) lists each faction's starting zones. Ammen Vale (Alliance) and Sunstrider Isle (Horde) are locked by default, so item_ascension_travel_permit offers only the three open destinations: Elwynn Forest, Dun Morogh and Teldrassil for the Alliance, Tirisfal Glades, Durotar and Mulgore for the Horde. Without the feature each faction sees four options. Requires the default Coa.Access.* values (all locked).",
  "timeout_ms": 90000,
  "players": [
    {
      "id": "alliance",
      "race": 1,
      "class": 1,
      "level": 5
    },
    {
      "id": "horde",
      "race": 5,
      "class": 1,
      "level": 5
    }
  ],
  "steps": [
    {
      "action": "wait",
      "label": "Let the fixtures settle",
      "ms": 3000
    },
    {
      "action": "add_item",
      "actor": "alliance",
      "item": 977028
    },
    {
      "action": "use_item",
      "label": "alliance uses the Travel Permit",
      "actor": "alliance",
      "item": 977028,
      "spell": 1001088
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: three destinations, not four",
      "actor": "alliance",
      "metric": "gossip_options",
      "equals": 3
    },
    {
      "action": "assert",
      "actor": "alliance",
      "metric": "gossip_option_text",
      "index": 0,
      "text": "Elwynn Forest",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "alliance",
      "metric": "gossip_option_text",
      "index": 1,
      "text": "Dun Morogh",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "alliance",
      "metric": "gossip_option_text",
      "index": 2,
      "text": "Teldrassil",
      "equals": 1
    },
    {
      "action": "add_item",
      "actor": "horde",
      "item": 977028
    },
    {
      "action": "use_item",
      "label": "horde uses the Travel Permit",
      "actor": "horde",
      "item": 977028,
      "spell": 1001088
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: three destinations, not four",
      "actor": "horde",
      "metric": "gossip_options",
      "equals": 3
    },
    {
      "action": "assert",
      "actor": "horde",
      "metric": "gossip_option_text",
      "index": 0,
      "text": "Tirisfal Glades",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "horde",
      "metric": "gossip_option_text",
      "index": 1,
      "text": "Durotar",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "horde",
      "metric": "gossip_option_text",
      "index": 2,
      "text": "Mulgore",
      "equals": 1
    }
  ]
}
